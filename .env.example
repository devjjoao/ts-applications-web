# URL pública cadastrada no Discord Developer Portal
PUBLIC_URL=http://localhost:3000
# Ambiente e porta HTTP
NODE_ENV=development
PORT=3000
# Ative apenas quando estiver atrás de um proxy reverso confiável
TRUST_PROXY=false
# Credenciais do OAuth2 do Discord (necessárias para login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Assinatura de sessão: use uma sequência aleatória longa em produção
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Opcional: chave separada usada para criptografar tokens no arquivo JSON
DATA_ENCRYPTION_KEY=troque-por-outra-chave-longa-e-aleatoria
# IDs Discord administrativos, separados por vírgula (também podem ficar em database/admins.json)
ADMIN_DISCORD_IDS=
# Opt-in: consulta geolocalização aproximada do IP no fluxo Auth02
ENABLE_IP_GEO=false
# Chave das rotas administrativas do Auth02
API_KEY=
# true usa data/auth-v2.json quando MySQL não estiver disponível
ALLOW_FILE_FALLBACK=true
# MySQL opcional da API Auth02; deixe vazio para utilizar o fallback JSON
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=30000
